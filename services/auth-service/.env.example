# auth-service environment variables
# Copy to .env and fill in real values before running locally.

# Postgres connection string (Aurora/RDS in AWS, local postgres in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db

# JWT signing secret — must match across all services
JWT_SECRET=change_me_to_a_long_random_string

# HTTP port this service listens on
PORT=3001

# Runtime environment: development | production
NODE_ENV=development
