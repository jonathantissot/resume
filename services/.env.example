# Root .env.example — shared environment variables for all services
# Copy to .env at this level OR copy the per-service .env.example into each
# service directory. The docker-compose.yml at this level sources these vars.

# ─── Shared auth ─────────────────────────────────────────────────────────────
# All services must share the same JWT_SECRET to verify each other's tokens.
JWT_SECRET=change_me_to_a_long_random_string

# ─── Database ────────────────────────────────────────────────────────────────
# Local development uses a single Postgres container with multiple databases.
# Aurora endpoints replace these in staging/production.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost

AUTH_DB_NAME=auth_db
POST_DB_NAME=post_db
COMMENT_DB_NAME=comment_db
LIKE_DB_NAME=like_db

AUTH_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/auth_db
POST_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/post_db
COMMENT_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/comment_db
LIKE_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/like_db

# ─── Service ports ───────────────────────────────────────────────────────────
AUTH_PORT=3001
POST_PORT=3002
COMMENT_PORT=3003
LIKE_PORT=3004
NOTIFICATION_PORT=3005

# ─── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# EventBridge bus (comment-service emits CommentCreated)
EVENTBRIDGE_BUS_NAME=resume-blog-bus

# SNS topic (like-service emits PostLiked)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:PostLiked

# SQS queue (notification-service polls this)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/resume-notifications

# SES verified sender (notification-service sends from this address)
SES_FROM_EMAIL=noreply@yourdomain.com

# ─── AWS credentials (local dev only) ────────────────────────────────────────
# Leave blank to use the default AWS credential chain (instance profile / SSO).
# In local dev you can paste temporary credentials here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
