# notification-service environment variables
# Copy to .env and fill in real values before running locally.
# This service has no DB — it polls SQS and sends email via SES.

# HTTP port this service listens on
PORT=3005

# Runtime environment: development | production
NODE_ENV=development

# AWS region for SQS + SES clients
AWS_REGION=us-east-1

# SQS queue URL to poll for notification events
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/resume-notifications

# SES verified sender address
SES_FROM_EMAIL=noreply@yourdomain.com
